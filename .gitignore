# Local build output — single static binary, built per machine.
/keyway
/keyway.exe
/keyway.exe~

# Local operator state — sealed secrets + throwaway test tenants.
*.db
*.db-shm
*.db-wal

# Stable SP signing identity — generated per deployment, never committed.
sp.key
sp.crt

# Local secrets for compose — copy .env.example, never commit.
.env

# Per-customer stacks — live secrets scaffolded by scripts/new-customer.ps1.
customers/
