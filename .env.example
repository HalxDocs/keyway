# Copy to .env and fill in. .env is gitignored — never commit it.
# Generate a fresh master key with: go run ./cmd/keyway keygen
# (or: docker run --rm keyway:local keygen)
KEYWAY_MASTER_KEY= PASTE_HEX_KEY_HERE

# Public base URL Keyway derives IdP callback URLs from. Loopback default
# works for local dev because the browser resolves it on the host.
KEYWAY_BASE_URL=http://127.0.0.1:8080

# Browser-facing Keyway origin embedded in demo login links. Follows
# KEYWAY_BASE_URL when Keyway is publicly reachable (tunnel/prod);
# loopback otherwise.
KEYWAY_PUBLIC_URL=http://127.0.0.1:8080

# Demo app wiring. DEMO_CONNECTION_ID is required when the tenant has more
# than one active connection; leave empty for single-connection tenants.
DEMO_TENANT=acme
DEMO_REDIRECT=http://localhost:3000/callback
DEMO_CONNECTION_ID=

# Static bearer token for /admin/* (Authorization: Bearer <token>).
# Empty means open: fine for localhost dev behind loopback-bound ports,
# never for production — the prod overlay refuses to start without it,
# and Caddy answers /admin/* with 404 at the public edge regardless.
# Generate with: openssl rand -hex 32
KEYWAY_ADMIN_TOKEN=
